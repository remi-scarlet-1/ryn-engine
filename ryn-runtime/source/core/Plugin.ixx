module;
#include <concepts>
#include <type_traits>

export module ryn.core:plugin;

import :types;

export namespace ryn {
    /// Version of the runtime/plugin binary interface. Plugins built against another version are rejected.
    constexpr u32 PLUGIN_ABI_VERSION = 3;

    /// Name of the function each plugin exports to return its PluginDesc.
    constexpr auto PLUGIN_GET_DESC_SYMBOL = "rynPluginGetDesc";

    /**
     * @brief   Tells the runtime how to create, drive and destroy a plugin's root.
     * @details Each plugin has exactly one root type. The runtime allocates the root's memory and calls
     *          FnConstruct, OnLoad, OnUnload and FnDestruct in that order. Generated by RYN_PLUGIN.
     * @warning Pointers refer into the plugin binary and are invalid once it is unloaded.
     */
    struct PluginDesc {
        u32         AbiVersion;            ///< PLUGIN_ABI_VERSION at build time.
        const char* Name;                  ///< Display name.
        usize       RootSize;              ///< sizeof the root type.
        usize       RootAlign;             ///< alignof the root type.
        void (*FnConstruct)(void* memory); ///< Constructs the root in memory.
        void (*FnDestruct)(void* root);    ///< Destroys the root.
        void (*OnLoad)(void* root);        ///< Called after construction.
        void (*OnUnload)(void* root);      ///< Called before destruction.
    };

    /// Signature of the PLUGIN_GET_DESC_SYMBOL function.
    using FnPluginGetDesc = const PluginDesc* (*)();

    /**
     * @brief   Satisfied by types usable as a plugin root.
     * @details Default constructible, provides onLoad() and onUnload(), no virtual functions.
     * @tparam  T Candidate root type.
     */
    template<typename T>
    concept IsPluginRoot = std::default_initializable<T> && requires(T root) {
        { root.onLoad() } -> std::same_as<void>;
        { root.onUnload() } -> std::same_as<void>;
    } && !std::is_polymorphic_v<T>;
}
